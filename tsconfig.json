{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib/types",
    "composite": false,
    "incremental": false,
    "noEmitOnError": true,
    "tsBuildInfoFile": "lib/.tsbuildinfo",
    // The plugin is out-of-tree: type-check against the harness's built
    // declarations (the profile fallback resolves the same packages at
    // runtime), not its sources.
    "paths": {
      "cordis": ["../vendor/cordis/lib/types/index.d.ts"],
      "schemastery": ["../vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["../packages/core/tools/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-credentials": ["../packages/credentials/credentials/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-skill": ["../packages/skill/skill/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-subprocess": ["../packages/subprocess/subprocess/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-llm": ["../packages/llm/llm/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session": ["../packages/core/session/lib/types/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["tests", "lib", "node_modules"]
}
