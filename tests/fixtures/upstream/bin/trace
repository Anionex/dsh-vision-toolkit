#!/usr/bin/env python3
"""Fixture trace: write a stub SVG and report the pinned vtracer summary."""
import os
import sys

args = sys.argv[1:]
out = None
scale = 1
for index, arg in enumerate(args):
    if arg == '-o' and index + 1 < len(args):
        out = args[index + 1]
    if arg == '--scale' and index + 1 < len(args):
        scale = int(args[index + 1])
if out is None:
    print('trace: missing output', file=sys.stderr)
    sys.exit(2)
os.makedirs(os.path.dirname(os.path.abspath(out)) or '.', exist_ok=True)
svg = '<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256"><path d="M 118 128 A 10 10 0 1 0 138 128 A 10 10 0 1 0 118 128 Z"/></svg>\n'
with open(out, 'w', encoding='utf-8') as handle:
    handle.write(svg)
print(f'wrote {out} ({len(svg)} bytes, 1 paths, traced at {scale}x)')
