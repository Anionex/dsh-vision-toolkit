#!/usr/bin/env python3
"""Fixture trace: write a stub SVG plus a machine-readable report."""
import json
import os
import sys

args = sys.argv[1:]
out = None
report = None
for index, arg in enumerate(args):
    if arg == '-o' and index + 1 < len(args):
        out = args[index + 1]
    if arg == '--report' and index + 1 < len(args):
        report = args[index + 1]
if out is None or report is None:
    print('trace: missing output/report', file=sys.stderr)
    sys.exit(2)
os.makedirs(os.path.dirname(os.path.abspath(out)) or '.', exist_ok=True)
with open(out, 'w', encoding='utf-8') as handle:
    handle.write('<svg xmlns="http://www.w3.org/2000/svg" data-trace-status="production" width="256" height="256"><circle cx="128" cy="128" r="10"/></svg>\n')
payload = {
    'version': 1,
    'mode': 'deterministic',
    'logical_size': [256, 256],
    'perception': {'label': 'circle', 'confidence': 'high'},
    'geometry': {
        'status': 'production',
        'confidence': 0.9,
        'primitive_count': 1,
        'representation': '1 circle',
        'stroke_width': 1.0,
        'pixel_fit': 0.95,
    },
}
with open(report, 'w', encoding='utf-8') as handle:
    json.dump(payload, handle)
print('wrote %s (456 bytes, 1 circle)' % out)
