#!/usr/bin/env python3
"""Fixture ground: one located element in the upstream line format."""
import sys

target = sys.argv[2] if len(sys.argv) > 2 else ''
if target == 'out-of-range':
    print('x1: 100, y1: 50, x2: 300, y2: 290')
elif target == 'unknown-output':
    print('the target is near the lower-right corner')
else:
    print('1. top-left send button x1: 100, y1: 50, x2: 200, y2: 90')
