#!/usr/bin/env python3
"""Fixture glance: deterministic description/OCR/QA output."""
import sys
import time

args = sys.argv[1:]
if '-q' in args and args[args.index('-q') + 1] == '__sleep__':
    time.sleep(5)
if '--ocr' in args:
    print('Fixture OCR text')
elif '-q' in args:
    print('Fixture answer to the question')
else:
    print('Fixture detailed description')
