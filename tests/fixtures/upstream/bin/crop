#!/usr/bin/env python3
"""Fixture crop: write a stub image and report the upstream result line."""
import sys

from PIL import Image

args = sys.argv[1:]
out = None
scale = 1
for index, arg in enumerate(args):
    if arg == '-o' and index + 1 < len(args):
        out = args[index + 1]
    if arg == '--scale' and index + 1 < len(args):
        scale = int(args[index + 1])
if out is None:
    print('crop: missing output', file=sys.stderr)
    sys.exit(2)
Image.new('RGB', (40 * scale, 20 * scale), '#336699').save(out)
print(f'wrote {out} ({40 * scale}x{20 * scale})')
