{
  "name": "@dsh-external/dsh-vision-toolkit",
  "version": "0.1.0",
  "description": "DSH native visual engineering toolkit with structured understanding, grounding, pixel verification, OCR, local rendering, managed Artifacts, health checks, unified credentials, and a bundled skill",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "runtime",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/upstream-manifest.mjs && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run tests",
    "upstream:manifest": "node scripts/upstream-manifest.mjs --write",
    "upstream:sync": "node scripts/sync-upstream.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "visionToolkit": {
      "upstreamRepository": "https://github.com/Anionex/agent-vision-toolkit",
      "upstreamVersion": "v0.1.0+snapshot.c27d1a3",
      "upstreamCommit": "c27d1a300962b553c0884993c575cd3e819465ce"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": "^0.0.1",
    "@deepseek-ai/dsh-skill": "^0.0.1",
    "@deepseek-ai/dsh-subprocess": "^0.0.1",
    "@deepseek-ai/dsh-tools": "^0.0.1",
    "cordis": "^4.0.0-rc.7",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
