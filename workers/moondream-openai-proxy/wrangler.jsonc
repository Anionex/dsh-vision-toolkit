{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dsh-vision-free",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "vision.anionex.me",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "USAGE_DB",
      "database_name": "dsh-vision-free-usage",
      "database_id": "ddea6054-165a-4737-9e9d-8000aca883de",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "BURST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_API_KEY": "https://agent-vision.anionex.me",
    "LEGACY_PUBLIC_API_KEY": "free",
    "DAILY_LIMIT": "100",
    "GLOBAL_DAILY_LIMIT": "1000000000",
    "MAX_IMAGE_BYTES": "4194304",
    "MAX_IMAGE_PIXELS": "20000000",
    "MAX_OUTPUT_TOKENS": "4096",
    "MAX_REQUEST_BYTES": "33554432"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
